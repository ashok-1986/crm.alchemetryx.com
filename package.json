{
	"name": "crm",
	"private": true,
	"license": "MIT",
	"version": "1.15.3",
	"scripts": {
		"prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\"",
		"build": "turbo run build --filter=!agent",
		"build:all": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:slop": "oxlint",
		"lint:dead": "knip --no-progress",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test --concurrency=1",
		"auth:generate": "turbo run auth:generate",
		"db:deploy": "turbo run db:deploy",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:push": "turbo run db:push",
		"db:reset": "turbo run db:reset",
		"db:seed": "turbo run db:seed",
		"db:studio": "turbo run db:studio",
		"db:test": "pnpm --filter @crm/db db:test"
	},
	"dependencies": {
		"turbo": "^2.10.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@oxlint/plugins": "1.78.0",
		"knip": "6.32.2",
		"oxlint": "1.78.0",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.24.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.24.0",
			"onFail": "error"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
